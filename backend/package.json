{
  "name": "assistant-redacteur-backend",
  "version": "1.0.0",
  "description": "Backend pour l'assistant rédactionnel",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/runMigration.js",
    "test:migration": "node scripts/testMigration.js",
    "db:init": "node -e \"import('./models/index.sequelize.js').then(m => m.initDatabase())\"",
    "db:migrate": "node scripts/migrateToMySQL.js",
    "clean": "node scripts/cleanForO2Switch.js",
    "clean:rename": "node scripts/cleanForO2Switch.js --rename"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dropbox": "^10.34.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.3.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-instagram": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-twitter": "^1.0.4",
    "pg": "^8.16.3",
    "puppeteer": "^24.36.0",
    "redis": "^4.6.8",
    "sequelize": "^6.37.7",
    "sharp": "^0.33.2",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "stripe": "^14.10.0",
    "twitter-api-v2": "^1.28.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "assistant-redacteur",
    "backend",
    "automation",
    "api",
    "nodejs"
  ],
  "author": "Assistant Rédacteur Team",
  "license": "MIT"
}
