# Configuration O2Switch - Assistant Rédacteur

# Environnement
NODE_ENV=production

# Port du serveur
PORT=4000

# Base de données MySQL (O2Switch)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bure7653_assistant
MYSQL_USER=bure7653
MYSQL_PASSWORD=votre_mot_de_passe_mysql

# JWT
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=votre_refresh_secret_super_securise_changez_moi
JWT_REFRESH_EXPIRE=30d

# Bcrypt
BCRYPT_ROUNDS=12

# Clé de chiffrement pour les API keys
ENCRYPTION_KEY=votre-cle-de-chiffrement-32-caracteres-minimum!!

# URL Frontend
FRONTEND_URL=https://assistant-redacteur.fr

# Dropbox
DROPBOX_ACCESS_TOKEN=votre_token_dropbox
DROPBOX_APP_KEY=votre_app_key_dropbox
DROPBOX_APP_SECRET=votre_app_secret_dropbox

# Email (si vous utilisez un service SMTP)
EMAIL_HOST=smtp.o2switch.fr
EMAIL_PORT=587
EMAIL_USER=noreply@assistant-redacteur.fr
EMAIL_PASSWORD=votre_mot_de_passe_email
EMAIL_FROM=noreply@assistant-redacteur.fr

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_PORT=4001

# OAuth (si utilisé)
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_CALLBACK_URL=https://assistant-redacteur.fr/api/oauth/google/callback

FACEBOOK_APP_ID=votre_facebook_app_id
FACEBOOK_APP_SECRET=votre_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://assistant-redacteur.fr/api/oauth/facebook/callback

TWITTER_API_KEY=votre_twitter_api_key
TWITTER_API_SECRET=votre_twitter_api_secret
TWITTER_CALLBACK_URL=https://assistant-redacteur.fr/api/oauth/twitter/callback

LINKEDIN_CLIENT_ID=votre_linkedin_client_id
LINKEDIN_CLIENT_SECRET=votre_linkedin_client_secret
LINKEDIN_CALLBACK_URL=https://assistant-redacteur.fr/api/oauth/linkedin/callback

# Stripe (pour les paiements)
STRIPE_SECRET_KEY=votre_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=votre_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=votre_stripe_webhook_secret
