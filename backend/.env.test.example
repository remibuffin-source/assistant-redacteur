# Configuration de test pour MySQL local

# Environnement
NODE_ENV=development

# Port du serveur
PORT=4000

# Base de données MySQL (Local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=assistant_redacteur_test
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT
JWT_SECRET=test-secret-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=test-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRE=30d

# Bcrypt
BCRYPT_ROUNDS=10

# Clé de chiffrement pour les API keys (32 caractères minimum)
ENCRYPTION_KEY=test-encryption-key-32-chars!!

# URL Frontend
FRONTEND_URL=http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_PORT=4001
