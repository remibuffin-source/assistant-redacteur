option_settings:
  # Configuration du Load Balancer pour HTTPS
  aws:elbv2:listener:443:
    ListenerEnabled: true
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:eu-west-1:559050224539:certificate/7af38a06-c0b4-427a-b984-25586d8f9f9f
  
  # Health check sur HTTP (port 80)
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    Port: '80'
    Protocol: HTTP
    HealthCheckInterval: '30'
    HealthCheckTimeout: '5'
    HealthyThresholdCount: '3'
    UnhealthyThresholdCount: '5'
    MatcherHTTPCode: '200'
  
  # Redirection HTTP vers HTTPS (optionnel)
  aws:elbv2:listener:80:
    ListenerEnabled: true
    Protocol: HTTP
    Rules: redirecttohttps

  # Règle de redirection
  aws:elbv2:listenerrule:redirecttohttps:
    PathPatterns: /*
    Priority: 1
    Process: default
    RedirectHost: '#{host}'
    RedirectPath: '/#{path}'
    RedirectPort: '443'
    RedirectProtocol: HTTPS
    RedirectQuery: '#{query}'
    RedirectStatusCode: '301'
