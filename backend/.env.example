# Configuration du serveur
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3003

# Base de données
REDIS_URL=redis://localhost:6379

# Stockage Dropbox (centralisé pour toute l'application)
DROPBOX_ACCESS_TOKEN=your-dropbox-app-access-token

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRE=30d

# OAuth - Google (pour l'authentification générale)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# OAuth - Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OAuth - Instagram
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# OAuth - TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# APIs tiers pour enrichissement de contenu
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Mode gratuit (clé OpenRouter pour utilisateurs non connectés ou sans crédits)
OPENROUTER_FREE_API_KEY=your-openrouter-api-key-for-free-mode
# Limite: 20 requêtes/jour par IP, max 1000 tokens par requête
# Modèle utilisé: moonshotai/kimi-k2:free

# Configuration sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Configuration logs
LOG_LEVEL=info
LOG_FILE=logs/backend.log

# Configuration file upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# Configuration cron jobs
CRON_TIMEZONE=Europe/Paris

# Clés de chiffrement (générer aléatoirement en production)
ENCRYPTION_KEY=your-32-character-encryption-key-for-sensitive-data

# Configuration SMTP (pour notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Webhooks (optionnel)
WEBHOOK_SECRET=your-webhook-secret-for-verification

# Intégration Postiz (pour publication multi-plateformes)
POSTIZ_API_URL=https://postiz.assistant-redacteur.fr/api
POSTIZ_API_KEY=your-postiz-api-key
POSTIZ_FRONTEND_URL=https://postiz.assistant-redacteur.fr
BACKEND_URL=https://api.assistant-redacteur.fr
