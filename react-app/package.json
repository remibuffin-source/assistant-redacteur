{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "email-server": "node server.js",
    "dev:stripe": "cd stripe-backend && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:stripe\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "pm2:dev": "node pm2-scripts.cjs dev:start",
    "pm2:dev:stop": "node pm2-scripts.cjs dev:stop",
    "pm2:dev:restart": "node pm2-scripts.cjs dev:restart",
    "pm2:dev:logs": "node pm2-scripts.cjs dev:logs",
    "pm2:prod": "node pm2-scripts.cjs prod:start",
    "pm2:prod:stop": "node pm2-scripts.cjs prod:stop",
    "pm2:prod:restart": "node pm2-scripts.cjs prod:restart",
    "pm2:prod:logs": "node pm2-scripts.cjs prod:logs",
    "pm2:status": "node pm2-scripts.cjs status",
    "pm2:monitor": "node pm2-scripts.cjs monitor",
    "pm2:help": "node pm2-scripts.cjs help"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@heroicons/react": "^2.2.0",
    "@stripe/react-stripe-js": "^5.0.0",
    "@stripe/stripe-js": "^8.0.0",
    "axios": "^1.12.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nodemailer": "^7.0.9",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^6.30.1",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.3",
    "babel-jest": "^30.1.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "vite": "^5.4.10"
  }
