# DeepSeek (DeepSeek Chat, DeepSeek V3)
# Obtenir sur : https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=sk-votre-cle-deepseek-ici

# xAI Grok (Grok, Grok 2)
