# Configuration des clés API pour les services IA
# Copiez ce fichier en .env.local et remplissez vos clés réelles

# OpenAI API (pour GPT-4)
VITE_OPENAI_API_KEY=votre_cle_api_openai_ici

# Anthropic API (pour Claude)
VITE_ANTHROPIC_API_KEY=votre_cle_api_anthropic_ici

# Google Gemini API
VITE_GEMINI_API_KEY=votre_cle_api_gemini_ici

# Configuration de l'application
VITE_APP_NAME="Assistant Rédacteur React"
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://localhost:3000/api

# Mode debug (true/false)
VITE_DEBUG=false