# ============================================
# CONFIGURATION STRIPE - Assistant Rédacteur
# ============================================
# Copiez ce fichier en .env.local et remplissez avec vos vraies clés

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_ICI

# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI

# Webhook secret (optionnel, pour la production)
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET_ICI

# ============================================
# COMMENT OBTENIR VOS CLÉS STRIPE
# ============================================
# 1. Créez un compte sur https://dashboard.stripe.com/register
# 2. Allez dans "Développeurs" > "Clés API"
# 3. Copiez la "Clé publiable" et la "Clé secrète"
# 4. En mode TEST, les clés commencent par pk_test_ et sk_test_

# ============================================
# CLÉS DE TEST STRIPE (POUR DÉVELOPPEMENT)
# ============================================
# Vous pouvez utiliser ces clés de test publiques :
# pk_test_51QKfDFP3zO8VQxxxxxxxxxxxxxxxxxxxxxxxxxxx
# sk_test_51QKfDFP3zO8VQxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ IMPORTANT : Ne commitez JAMAIS vos vraies clés dans Git !
# Le fichier .env.local est ignoré par Git pour votre sécurité.
