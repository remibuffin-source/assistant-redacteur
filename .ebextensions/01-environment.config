option_settings:
  # Configuration de l'instance
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.small
    EC2KeyName: assistant-redacteur-key
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
    
  # Configuration de l'auto-scaling
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    
  # Configuration de l'environnement
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    ServiceRole: aws-elasticbeanstalk-service-role
    
  # Configuration du load balancer
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    HealthCheckInterval: 30
    HealthCheckTimeout: 5
    UnhealthyThresholdCount: 3
    HealthyThresholdCount: 2
    
  # Variables d'environnement
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    
  # Configuration Docker
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: none
    
  # Logs
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

# Commandes à exécuter lors du déploiement
commands:
  01_install_docker_compose:
    command: |
      if ! command -v docker-compose &> /dev/null; then
        curl -L "https://github.com/docker/compose/releases/download/1.29.2/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
        chmod +x /usr/local/bin/docker-compose
      fi
    ignoreErrors: false

container_commands:
  01_setup_permissions:
    command: |
      chmod -R 755 /var/app/current/backend
      chmod -R 755 /var/app/current/nginx
    ignoreErrors: true
