# Configuration du serveur
PORT=4000
NODE_ENV=development

# URL du frontend
FRONTEND_URL=http://localhost:3003

# Configuration Dropbox
DROPBOX_CLIENT_ID=votre_client_id_ici
DROPBOX_CLIENT_SECRET=votre_client_secret_ici
DROPBOX_REDIRECT_URI=http://localhost:3003/auth/dropbox/callback

# Configuration de la base de données (exemple avec MongoDB)
MONGODB_URI=mongodb://localhost:27017/assistant_redacteur

# Clé secrète pour les JWT
JWT_SECRET=votre_jwt_secret_tres_long_et_securise
JWT_EXPIRES_IN=30d

# Configuration des emails (exemple avec SendGrid)
SENDGRID_API_KEY=votre_cle_api_sendgrid
EMAIL_FROM=noreply@assistant-redacteur.fr

# Configuration du taux de limitation
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Configuration des logs
LOG_LEVEL=info

# Configuration Socket.IO
SOCKET_PORT=4001
