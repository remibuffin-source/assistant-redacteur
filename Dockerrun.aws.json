{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "backend-api",
      "image": "node:20-alpine",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 4000,
          "containerPort": 4000
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "backend-source",
          "containerPath": "/app"
        }
      ],
      "workingDirectory": "/app",
      "command": ["npm", "start"],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4000"
        }
      ],
      "links": ["stripe-server", "email-service"]
    },
    {
      "name": "stripe-server",
      "image": "node:20-alpine",
      "essential": false,
      "memory": 256,
      "portMappings": [
        {
          "hostPort": 3005,
          "containerPort": 3005
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "stripe-source",
          "containerPath": "/app"
        }
      ],
      "workingDirectory": "/app",
      "command": ["npm", "start"],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3005"
        }
      ]
    },
    {
      "name": "email-service",
      "image": "node:20-alpine",
      "essential": false,
      "memory": 256,
      "portMappings": [
        {
          "hostPort": 3001,
          "containerPort": 3001
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "email-source",
          "containerPath": "/app"
        }
      ],
      "workingDirectory": "/app",
      "command": ["npm", "start"],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3001"
        }
      ]
    },
    {
      "name": "nginx-proxy",
      "image": "nginx:alpine",
      "essential": true,
      "memory": 128,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 80
        },
        {
          "hostPort": 443,
          "containerPort": 443
        }
      ],
      "links": ["backend-api", "stripe-server", "email-service"],
      "mountPoints": [
        {
          "sourceVolume": "nginx-config",
          "containerPath": "/etc/nginx/conf.d",
          "readOnly": true
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "backend-source",
      "host": {
        "sourcePath": "/var/app/current/backend"
      }
    },
    {
      "name": "stripe-source",
      "host": {
        "sourcePath": "/var/app/current/stripe-backend"
      }
    },
    {
      "name": "email-source",
      "host": {
        "sourcePath": "/var/app/current/email-service"
      }
    },
    {
      "name": "nginx-config",
      "host": {
        "sourcePath": "/var/app/current/nginx"
      }
    }
  ]
}
